 "breathGroundClip": {
  "appliesTo": [
   "breath_start",
   "breath_loop",
   "breath_end",
   "and _molten variants"
  ],
  "groundDyPx": {
   "right": 0,
   "left": 0,
   "down": 36,
   "up": null
  },
  "rule": "Per frame, with mouth=(mx,my) px rel. dragon origin (y down, from attacks.json mouthData: x-320, y-400) and a=angleDeg: s=sin(a). If groundDy[facing] is null (up) or s<0.2 there is no ground hit: draw full stream. Else dGround=(groundDy-my)/s. If dGround<streamLen(frame) the stream is clipped: visibleLen=dGround, hit point=(mx+cos(a)*dGround, groundDy) in dragon space.",
  "streamLenPx": {
   "breath_start": [
    70,
    150,
    230,
    300
   ],
   "breath_loop": 330,
   "breath_end": 330
  },
  "runtimeClip": "Preferred: a rectangle GeometryMask covering everything above worldGroundY = dragon.y + groundDy*scale (pixels below the ground line hidden; this is exactly what the previews bake). Cheaper alternative: setCrop(0,0,pivotPx.x+dGround+6,h) on the unrotated stream frame (crop is in texture space before rotation, so it cuts across the stream at dGround; the lower cone edge can poke <=~half-width*cos(a) px past the ground, hidden by the splash).",
  "splashAtHit": "While clipped: ground_fire(_molten) at the hit point every frame (flipX when facing left), burn_patch(_molten) dropped every ~150 ms at hit point +-10 px x, +4 px y (drawn under the body), smoke_wisp x2 at the last hit point when breath_end starts. Hit area: ground_fire hitRadius around the hit point; the cone hit test should also be limited to dist<=dGround."
 },
 "directions": {
  "facings": [
   "right",
   "left",
   "down",
   "up"
  ],
  "up": {
   "drawOrder": "behindBody",
   "note": "Aiming up (away from camera) the breath leaves the back/top of the head: draw breath_*, mouth_ignite, spark_burst and fireballs at a depth BELOW the dragon body sprite (e.g. depth=dragon.depth-1). No ground hit (groundDy null). Use mouthData up angles as given (around -90)."
  },
  "down": {
   "drawOrder": "aboveBody",
   "groundDyPx": 36,
   "note": "front view: ground line is the front edge of the shadow, 36 px below origin"
  },
  "left": {
   "drawOrder": "aboveBody",
   "note": "ground-aligned FX flipX; directional FX rotate by angleDeg and flipY when cos<0"
  },
  "right": {
   "drawOrder": "aboveBody"
  }
 }
